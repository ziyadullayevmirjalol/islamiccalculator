# Template for .env — copy to .env and fill in real values.
# .env is gitignored; all secrets live there, never in code or compose files.

APP_ENV=dev
LOG_LEVEL=debug
HTTP_PORT=8080

# Postgres container bootstrap (read by docker-compose)
POSTGRES_USER=islamic
POSTGRES_PASSWORD=change-me
POSTGRES_DB=islamiccalculator
POSTGRES_HOST_PORT=5432

# App database connection (must match the container values above)
DB_HOST=localhost
DB_PORT=5432
DB_USER=islamic
DB_PASSWORD=change-me
DB_NAME=islamiccalculator
DB_SSLMODE=disable

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=change-me
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h

# Hardening
RATE_LIMIT_PER_MIN=120
HTTP_MAX_BODY_BYTES=65536

# Live metal prices (metals.dev). Empty key = refresher off, stored
# prices served with staleness flags.
METALS_API_KEY=
METALS_API_URL=https://api.metals.dev/v1/latest
METALS_CURRENCY=UZS
METALS_REFRESH_INTERVAL=6h
METALS_STALE_AFTER=48h
