    {
      "name": "History (auth required)",
      "item": [
        {
          "name": "List my calculations",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const d = pm.response.json().data;",
                  "if (d && d.entries && d.entries.length) {",
                  "  pm.collectionVariables.set('historyId', d.entries[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/history/?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "history",
                ""
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "calcType",
                  "value": "finance.murabaha",
                  "disabled": true
                }
              ]
            },
            "description": "Saves the newest entry's id into {{historyId}} for the delete request. Enable the calcType query param to filter."
          }
        },
        {
          "name": "Delete a calculation",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/history/{{historyId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "history",
                "{{historyId}}"
              ]
            },
            "description": "Uses {{historyId}} captured by the list request. 404 if the entry isn't yours."
          }
        }
      ]
